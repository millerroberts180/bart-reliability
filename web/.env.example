# Copy to .env.local to override. Never put secrets in VITE_* variables:
# Vite inlines them into the public bundle.

# Data source for the prototype. Only "mock" works in Milestone 1;
# "http" selects the placeholder client, which makes no requests and fails.
VITE_DATA_MODE=mock

# Future API origin for VITE_DATA_MODE=http (not used yet).
VITE_API_BASE_URL=

# Production base path. Defaults to /bart-reliability/ for GitHub Pages
# project sites; set to / for a root deployment. Dev always serves from /.
VITE_BASE_PATH=/bart-reliability/
