# Copy to .env.local to override (it is ignored by git). Never put secrets in
# VITE_* variables: Vite inlines them into the public bundle.

# Data source. "mock" (the default, and what the tests use) serves simulated
# fixtures. "http" reads the local prediction API, which answers as a
# historical replay of recorded BART data; start it with `bart-serve-local`.
# "static" reads the published historical replay in public/replay/, as the
# GitHub Pages build does.
# The mode is fixed when the site is built or served, and each build contains
# only that mode's client and data. Any other value is refused.
# Select one for one run without editing a file: npm run dev:http (or dev:static),
# or VITE_DATA_MODE=http npm run dev
VITE_DATA_MODE=mock

# API origin for VITE_DATA_MODE=http, without a trailing /api/v1. For local
# development: http://127.0.0.1:8000. Leave empty with mock data.
VITE_API_BASE_URL=

# Production base path. Defaults to /bart-reliability/ for GitHub Pages
# project sites; set to / for a root deployment. Dev always serves from /.
VITE_BASE_PATH=/bart-reliability/
